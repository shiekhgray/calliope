<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for devices older than API 31.
   See https://developer.android.com/guide/topics/data/autobackup
   API 31+ uses data_extraction_rules.xml instead.
-->
<full-backup-content>
    <!-- JWTs live in EncryptedSharedPreferences. The MasterKey that decrypts them is
         non-exportable Android Keystore material, so a restored prefs file cannot be
         read and throws on access. Exclude it; the user just logs in again. -->
    <exclude domain="sharedpref" path="calliope_tokens.xml"/>
</full-backup-content>
