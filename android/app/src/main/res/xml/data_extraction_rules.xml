<?xml version="1.0" encoding="utf-8"?><!--
   Backup / device-transfer rules for API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- JWTs live in EncryptedSharedPreferences. The MasterKey that decrypts them is
             non-exportable Android Keystore material, so a restored prefs file cannot be
             read and throws on access. Exclude it; the user just logs in again. -->
        <exclude domain="sharedpref" path="calliope_tokens.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Same reasoning: the key does not travel with the file. -->
        <exclude domain="sharedpref" path="calliope_tokens.xml"/>
    </device-transfer>
</data-extraction-rules>
